# Server only. Never use EXPO_PUBLIC_ for private keys.
HOST=127.0.0.1
PORT=3001
X_BEARER_TOKEN=
X_CANDIDATE_LIMIT=500
# Default 0: do not persist third-party post content. Optional capped TTL is <=24h.
# TTL alone does not establish policy compliance; process deletion requests too.
X_CONTENT_RETENTION_HOURS=0
AI_BASE_URL=https://your-provider.example/v1
AI_API_KEY=
AI_MODEL=
